# Dependencies
node_modules/

# Environment variables & secrets
.env
.env.*
!.env.example

# Local runtime cache
.local-radar-store.json

# Build outputs & local indexes
dist/
build/
.output/
.wxt/
.codegraph/

# Chrome's unpacked-extension metadata dir
extension/_metadata/

# Firefox extension build output (regenerate with bun run build:ext:firefox)
extension-firefox/

# Extension build artifact (always regenerate with bun run build:ext + zip)
yt-topic-radar-extension.zip

# Demo recordings & throwaway Playwright specs (not part of the product build)
demo-videos*/
test-results/
*.mp4
demo_*.spec.ts
*.log

# Playwright MCP scratch output (page snapshots + console dumps)
.playwright-mcp/
